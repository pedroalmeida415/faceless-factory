{
  "name": "faceless-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "biome check --no-errors-on-unmatched --max-diagnostics=none .",
    "check:unsafe": "biome check --write --unsafe --no-errors-on-unmatched --max-diagnostics=none .",
    "check:write": "biome check --write --no-errors-on-unmatched --max-diagnostics=none .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "preview": "next build && next start",
    "stripe:bootstrap": "bun src/server/billing/bootstrap.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker:workflow": "bun src/server/workflow/worker.ts",
    "worker:workflow:dev": "bun --watch src/server/workflow/worker.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@base-ui/react": "^1.4.1",
