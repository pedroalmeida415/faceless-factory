    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3"
