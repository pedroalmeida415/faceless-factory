    "@remixicon/react": "^4.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.99.0",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "better-auth": "^1.6.6",
    "bullmq": "^5.75.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.1",
    "immer": "^11.1.4",
    "next": "15.5.15",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reactflow": "^11.11.4",
    "redis": "^5.12.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.3.0",
    "stripe": "^22.0.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
