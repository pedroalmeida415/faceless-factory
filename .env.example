# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# App URL used for Better Auth callbacks and redirects
BETTER_AUTH_URL="http://localhost:3000"

# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Better Auth GitHub OAuth
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/faceless-factory"

# Redis
REDIS_URL="redis://localhost:6379"

# Vertex AI
# Project used for Gemini / Veo generation calls on Vertex AI
GOOGLE_CLOUD_PROJECT=""

# Shared fallback location for Vertex-backed calls
GOOGLE_CLOUD_LOCATION="us-central1"

# Image generation location. Gemini image models support `global`.
GOOGLE_CLOUD_LOCATION_IMAGE="global"

# Video generation location. Veo 3.1 runs from `us-central1`.
GOOGLE_CLOUD_LOCATION_VIDEO="us-central1"

# Auth options for Vertex AI. Use one of these:
# 1. Application Default Credentials file path
GOOGLE_APPLICATION_CREDENTIALS=""
# 2. Raw service account JSON
GOOGLE_SERVICE_ACCOUNT_JSON=""
# 3. Split service account fields
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
