# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This committed file contains placeholders only. Copy it to ".env" and replace
# the placeholders with local values. Never commit the populated file.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# App URL used for Better Auth callbacks and redirects
BETTER_AUTH_URL="http://localhost:3000"

# Secret used by Better Auth
BETTER_AUTH_SECRET="replace-with-a-local-secret"

# Better Auth GitHub OAuth
BETTER_AUTH_GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
BETTER_AUTH_GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"

# Drizzle
DATABASE_URL="postgresql://postgres:replace-with-local-postgres-password@localhost:5432/faceless-factory"
POSTGRES_PASSWORD="replace-with-local-postgres-password"

# Redis
REDIS_URL="redis://localhost:6379"

# Object Storage (MinIO locally, S3-compatible providers in deployed envs)
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET="faceless-factory"
OBJECT_STORAGE_ACCESS_KEY_ID="replace-with-local-object-storage-access-key"
OBJECT_STORAGE_SECRET_ACCESS_KEY="replace-with-local-object-storage-secret-key"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# Stripe
STRIPE_SECRET_KEY="replace-with-stripe-test-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-test-webhook-secret"

# Vertex AI
# Project used for Gemini / Veo generation calls on Vertex AI
GOOGLE_CLOUD_PROJECT=""

# Shared fallback location for Vertex-backed calls
GOOGLE_CLOUD_LOCATION="us-central1"

# Image generation location. Gemini image models support `global`.
GOOGLE_CLOUD_LOCATION_IMAGE="global"

# Video generation location. Veo 3.1 runs from `us-central1`.
GOOGLE_CLOUD_LOCATION_VIDEO="us-central1"

# Auth options for Vertex AI. Use one of these:
# 1. Application Default Credentials file path
GOOGLE_APPLICATION_CREDENTIALS=""
# 2. Raw service account JSON
GOOGLE_SERVICE_ACCOUNT_JSON=""
# 3. Split service account fields
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
